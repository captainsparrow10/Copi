LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:14b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
GOOGLE_GENERATIVE_AI_API_KEY=
DATABASE_URL=postgres://user:password@localhost:5432/copago
SESSION_SECRET=generate-with-openssl-rand-base64-32
# Calibrated against ollama/nomic-embed-text (see README RAG section): 0.70
# rejected nearly every real symptom query (nomic's cosine similarities for
# short Spanish text cluster in ~0.55-0.85, not the 0-1 range the PRD default
# assumed). 0.67 was the lowest value with zero false positives against a
# 12 relevant / 8 nonsense calibration set. Re-measure if you change EMBED_MODEL.
RAG_MIN_SCORE=0.67
MAX_MESSAGES_PER_SESSION=20

# Fictitious demo customer-service contact for "Cerrar cotización" (lib/config/customer-service.ts).
# All optional — omit any of these to fall back to the demo defaults baked into that file.
CUSTOMER_SERVICE_PHONE=+507 800-COPI (800-2674)
CUSTOMER_SERVICE_WHATSAPP=+507 6000-1234
CUSTOMER_SERVICE_EMAIL=servicioalcliente@copi-demo.example
CUSTOMER_SERVICE_HOURS=Lunes a viernes, 8:00 a.m. a 6:00 p.m. (hora de Panamá)
