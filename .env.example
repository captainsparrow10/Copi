# Production (cloud): DeepSeek for chat; embeddings run inside the app (Transformers.js),
# so no other AI service or key is needed. Server-side only: never prefix with NEXT_PUBLIC_.
LLM_PROVIDER=deepseek
CHAT_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
EMBED_PROVIDER=local
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBED_DIM=768
# Where the local embedding model (~140 MB) is cached. Serverless hosts only allow /tmp.
EMBED_CACHE_DIR=/tmp/transformers-cache
# Local alternative for chat: LLM_PROVIDER=ollama, OLLAMA_URL=http://localhost:11434, CHAT_MODEL=qwen2.5:14b.

# InsForge Postgres: `npx -y @insforge/cli db connection-string`
DATABASE_URL=postgresql://user:password@host:5432/insforge?sslmode=require
SESSION_SECRET=generate-with-openssl-rand-base64-32
# Postgres connections per server instance. Use a small value (e.g. 3) on serverless hosting.
DB_POOL_MAX=10
# Minimum cosine similarity for a specialty-guide match. Depends on EMBED_MODEL.
# nomic-embed-text-v1.5 (768 dims): clear symptoms 0.689-0.858; nonsense, vague malaise and
# quote follow-up questions 0.584-0.651 -> 0.67. Re-measure whenever EMBED_MODEL changes.
RAG_MIN_SCORE=0.67
MAX_MESSAGES_PER_SESSION=20

# Fictitious demo customer-service contact for "Cerrar cotización" (lib/config/customer-service.ts).
# All optional — omit any of these to fall back to the demo defaults baked into that file.
CUSTOMER_SERVICE_PHONE=+507 800-COPI (800-2674)
CUSTOMER_SERVICE_WHATSAPP=+507 6000-1234
CUSTOMER_SERVICE_EMAIL=servicioalcliente@copi-demo.example
CUSTOMER_SERVICE_HOURS=Lunes a viernes, 8:00 a.m. a 6:00 p.m. (hora de Panamá)
